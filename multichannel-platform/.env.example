# ==============================================================
# MULTICHANNEL ECOMMERCE PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================

# Application Environment
NODE_ENV=development
PORT=5000
WORKER_PORT=5001
WEB_PORT=3000

# Base URLs
API_BASE_URL=http://localhost:5000
WEB_BASE_URL=http://localhost:3000

# Security & Secrets
JWT_SECRET=super_secure_jwt_secret_change_in_production_32chars!
JWT_REFRESH_SECRET=super_secure_refresh_token_secret_change_in_production!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.6ttwc0c.mongodb.net/multichannel_platform
MONGODB_TEST_URI=mongodb+srv://<username>:<password>@cluster0.6ttwc0c.mongodb.net/multichannel_platform_test

# Redis & BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USE_EMBEDDED_FALLBACK=true

# Shopify App Credentials (Optional for local development)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_inventory,write_inventory,read_orders,write_orders
SHOPIFY_APP_URL=http://localhost:5000/api/v1/integrations/shopify/callback

# eBay App Credentials (Optional for local development)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RUNAME=
EBAY_ENVIRONMENT=SANDBOX

# Custom Connector Defaults
CUSTOM_CONNECTOR_TIMEOUT_MS=10000
CUSTOM_CONNECTOR_MAX_REDIRECTS=3

# Rate Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
