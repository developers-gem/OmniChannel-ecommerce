{
  "name": "multichannel-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Centralized Multichannel Ecommerce Management Platform (Shopify, eBay, Custom REST)",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev:api": "npm run dev --workspace=@multichannel/api",
    "dev:worker": "npm run dev --workspace=@multichannel/worker",
    "dev:web": "npm run dev --workspace=@multichannel/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "test": "vitest run tests --fileParallelism=false",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}